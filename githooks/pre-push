#!/bin/sh
# enabled by `git config core.hooksPath githooks`
# Refuses the push if a new commit has the wrong author, a trailer, a forbidden term or changes the code without the README (orq audit-publication).
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then set -- "$local_sha" --not --remotes; else set -- "$remote_sha..$local_sha"; fi
  python3 "$(git rev-parse --show-toplevel)/orq.py" audit-publication -- "$@" || exit 1
done
